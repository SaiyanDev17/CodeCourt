# Frontend Environment Variables

# Express API URL
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:5000/api
#
# Vercel production:
# Leave NEXT_PUBLIC_API_URL unset, or set it to /api.
# vercel.json rewrites /api/* to the deployed backend.
# Do not set this to http://<ec2-ip>:5000/api on Vercel because HTTPS pages
# cannot call plain HTTP APIs directly from the browser.
# NEXT_PUBLIC_API_URL=/api

# FastAPI AI Service URL
NEXT_PUBLIC_AI_API_URL=http://localhost:8000

# Socket.io URL
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
